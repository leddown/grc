% carelock.sty — LaTeX equivalent of templates/typst/brand.typ.
%
% Provided for clients whose house style is already LaTeX, or where a
% deliverable must be produced by a toolchain that has no Typst. The Typst
% templates are the primary path (see DOCUMENT_TEMPLATES.md for why); this
% package deliberately mirrors their typography so the two produce documents
% that look like they came from the same firm.
%
% Requires XeLaTeX or LuaLaTeX for the font stack. Compile with:
%   latexmk -xelatex policy-document.tex
%
% Everything a rebrand needs is in the "Identity" and "Palette" blocks below.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{carelock}[2026/08/01 CareLock Consulting document style]

\RequirePackage{iftex}
% The [table] option is what provides \rowcolors and pulls in colortbl; loading
% plain xcolor plus colortbl separately does not.
\RequirePackage[table]{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% ---------------------------------------------------------------------------
% Identity — edit these
% ---------------------------------------------------------------------------
\newcommand{\clFirm}{CareLock Consulting}
\newcommand{\clTagline}{Risk and Control Advisory}
\newcommand{\clFooterNote}{Uncontrolled when printed.}

% ---------------------------------------------------------------------------
% Palette — mirrors brand.typ
% ---------------------------------------------------------------------------
\definecolor{clAccent}{HTML}{7A1F2E}
\definecolor{clAccentDark}{HTML}{5C1622}
\definecolor{clInk}{HTML}{1B1B1B}
\definecolor{clMuted}{HTML}{5F6368}
\definecolor{clRule}{HTML}{C8C5C0}
\definecolor{clTableHead}{HTML}{F2F0ED}
\definecolor{clTableZebra}{HTML}{FAF9F8}
\definecolor{clOk}{HTML}{1D6B45}
\definecolor{clWarn}{HTML}{8A6100}
\definecolor{clRisk}{HTML}{A32B1C}

% ---------------------------------------------------------------------------
% Type
% ---------------------------------------------------------------------------
% Serif body, sans headings — the same contrast the Typst templates use, and the
% reason both stay readable when a client prints in greyscale.
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{times}
\else
  \RequirePackage{fontspec}
  % Font stacks are not expressible in fontspec the way they are in Typst, so
  % each face is guarded: a missing font is a build error otherwise, which is a
  % worse failure than falling back.
  \IfFontExistsTF{Libertinus Serif}{\setmainfont{Libertinus Serif}}{%
    \IfFontExistsTF{Liberation Serif}{\setmainfont{Liberation Serif}}{}}
  \IfFontExistsTF{Liberation Sans}{\setsansfont{Liberation Sans}}{}
  \IfFontExistsTF{Liberation Mono}{\setmonofont{Liberation Mono}}{}
\fi

% 11pt on a 150mm measure lands near 86 characters per line — the top of the
% 45–90 band that legibility research puts as comfortable, and the widest a
% business document should run.
\geometry{a4paper, left=30mm, right=30mm, top=28mm, bottom=26mm,
          headheight=14pt, headsep=10mm, footskip=12mm}

\color{clInk}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.7\baselineskip}
\linespread{1.06}

% Widow and orphan control. Without these a single stranded line at a page break
% is the most visible tell that a document came out of a default template.
\widowpenalty=10000
\clubpenalty=10000
\raggedbottom

\titleformat{\section}{\sffamily\bfseries\large\color{clInk}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\sffamily\bfseries\normalsize\color{clInk}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\sffamily\bfseries\small\color{clMuted}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.5em}{0.7em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.5em}

\setlist[itemize]{leftmargin=1.2em, itemsep=0.35em, topsep=0.4em}
\setlist[enumerate]{leftmargin=1.4em, itemsep=0.35em, topsep=0.4em}

% ---------------------------------------------------------------------------
% Document metadata, set by the document preamble
% ---------------------------------------------------------------------------
\newcommand{\clReference}{}
\newcommand{\clClassification}{Internal}
\newcommand{\clDocTitle}{}
\newcommand{\setclreference}[1]{\renewcommand{\clReference}{#1}}
\newcommand{\setclclassification}[1]{\renewcommand{\clClassification}{#1}}
\newcommand{\setcldoctitle}[1]{\renewcommand{\clDocTitle}{#1}}

% Classification colour, resolved at use time.
\newcommand{\clClassColour}{%
  \ifnum\pdfstrcmp{\clClassification}{Public}=0 clOk\else
  \ifnum\pdfstrcmp{\clClassification}{Restricted}=0 clRisk\else
  \ifnum\pdfstrcmp{\clClassification}{Confidential}=0 clWarn\else clMuted\fi\fi\fi}

% ---------------------------------------------------------------------------
% Page furniture
% ---------------------------------------------------------------------------
% Classification is marked on every page, not only the cover: a page separated
% from its document has to carry its own handling instruction. "Page X of Y"
% for the same reason — "Page 4" does not tell a reader holding a printout
% whether they have the whole thing.
\fancypagestyle{clbody}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0.5pt}
  \renewcommand{\footrulewidth}{0.5pt}
  \fancyhead[L]{\sffamily\scriptsize\color{clMuted}\clReference\ \textperiodcentered\ \clDocTitle}
  \fancyhead[R]{\sffamily\scriptsize\bfseries\csname color\endcsname{\clClassColour}\MakeUppercase{\clClassification}}
  \fancyfoot[L]{\sffamily\scriptsize\color{clMuted}\clFooterNote}
  \fancyfoot[C]{\sffamily\scriptsize\bfseries\csname color\endcsname{\clClassColour}\MakeUppercase{\clClassification}}
  \fancyfoot[R]{\sffamily\scriptsize\color{clMuted}Page \thepage\ of \pageref{LastPage}}
}
% Both must respect the width fancyhdr sets, or the cover page — which sets the
% widths to 0pt via the clcover style — still draws them.
\renewcommand{\headrule}{\ifdim\headrulewidth>0pt\relax{\color{clRule}\hrule height \headrulewidth}\fi}
\renewcommand{\footrule}{\ifdim\footrulewidth>0pt\relax{\color{clRule}\hrule height \footrulewidth}\fi}

\fancypagestyle{clcover}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}

% ---------------------------------------------------------------------------
% Components
% ---------------------------------------------------------------------------
\newcommand{\cllabel}[1]{{\sffamily\fontsize{7.5}{9}\selectfont\color{clMuted}\MakeUppercase{#1}}}

\newcommand{\clwordmark}{{\sffamily\bfseries\large\color{clAccent}\MakeUppercase{\clFirm}}}

% \clpill{colour}{text}
\newcommand{\clpill}[2]{%
  \tcbox[on line, boxsep=0pt, left=5pt, right=5pt, top=2.5pt, bottom=2.5pt,
         colback=white, colframe=#1, boxrule=0.6pt, arc=2pt]{%
    \sffamily\fontsize{7.5}{9}\selectfont\color{#1}\MakeUppercase{#2}}}

% Document-control key/value table.
%
% Uses tabular with an explicitly computed second column rather than tabularx.
% tabularx reads its body as an argument by scanning for \end{tabularx}, so it
% cannot be split across a custom environment's begin and end code — doing that
% fails with "Missing } inserted" at the \end, which is not an obvious symptom
% of the actual cause.
\newlength{\clkvvaluewidth}
\newenvironment{clkvtable}{%
  \setlength{\clkvvaluewidth}{\dimexpr\linewidth-38mm-4\tabcolsep\relax}%
  \renewcommand{\arraystretch}{1.35}%
  \rowcolors{1}{}{clTableZebra}%
  \tabular{@{}>{\sffamily\small\color{clMuted}}p{38mm}p{\clkvvaluewidth}@{}}
  \toprule
}{%
  \bottomrule
  \endtabular
  \renewcommand{\arraystretch}{1}%
}

% Callout box — executive summaries, scope notes.
\newtcolorbox{clcallout}[1][]{%
  breakable, enhanced, colback=clTableZebra, colframe=clRule, boxrule=0.4pt,
  arc=2pt, left=10pt, right=10pt, top=8pt, bottom=8pt,
  borderline west={2.5pt}{0pt}{clAccent}, #1}

% Cover page. Arguments: title, subtitle, client.
% Vertical spacing here uses \par + \vspace throughout rather than \\[len].
% A \\ following \vfill or a \rule is in vertical mode, where LaTeX raises
% "There's no line here to end" — which is exactly what the first draft of this
% macro did.
\newcommand{\clcoverpage}[3]{%
  \thispagestyle{clcover}
  \setlength{\parskip}{0pt}%
  \clwordmark\par
  \cllabel{\clTagline}\par
  \vfill
  {\color{clAccent}\rule{46mm}{2.5pt}}\par
  \vspace{0.6em}
  {\sffamily\bfseries\fontsize{30}{34}\selectfont\color{clInk}#1\par}
  \ifx\relax#2\relax\else
    \vspace{0.5em}{\sffamily\fontsize{13}{16}\selectfont\color{clMuted}#2\par}%
  \fi
  \ifx\relax#3\relax\else
    \vspace{1.1em}\cllabel{Prepared for}\par
    {\fontsize{12}{15}\selectfont #3\par}%
  \fi
  \vfill\vfill
  {\color{clRule}\rule{\linewidth}{0.5pt}}\par
  \vspace{0.7em}
  \setlength{\parskip}{0.7\baselineskip}%
}

% Signature block. Real signature lines matter: a policy that cannot be
% wet-signed is one a client cannot put in an audit file.
\newcommand{\clapproval}[3]{%
  \needspace{6\baselineskip}
  \section*{Approval}
  \addcontentsline{toc}{section}{Approval}
  \begin{tabularx}{\linewidth}{@{}XX@{}}
    \cllabel{Approved by}\newline #1 & \cllabel{Document owner}\newline #2 \\[9mm]
    \rule{0.85\linewidth}{0.5pt}\newline\cllabel{Signature} &
    \rule{0.85\linewidth}{0.5pt}\newline\cllabel{Date} \\
  \end{tabularx}
  \par\vspace{0.6em}
  {\fontsize{7.5}{9}\selectfont\color{clMuted}Effective from #3.}
}

\endinput
