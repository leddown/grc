# Database configuration for the dev/run helper scripts:
#   scripts/db-switch.sh   - flip the active profile (local | remote)
#   scripts/run-app.sh     - run the active profile
#   scripts/db-sync.sh     - push local data up to remote / pull remote down
#
# Copy this file to config/db.env and edit it. config/db.env is gitignored
# because REMOTE_DATABASE_URL contains credentials.

# Which profile scripts/run-app.sh launches: "local" or "remote".
ACTIVE_BACKEND=local

# --- Local profile: embedded SQLite, no-login laptop mode ---
LOCAL_SQLITE_PATH=local.db
# Run the local profile with auth disabled (single-user laptop). Set to false
# to require login locally too.
LOCAL_MODE=true

# --- Remote profile: external PostgreSQL with normal auth ---
# Standard connection string. The schema is created automatically on first use.
REMOTE_DATABASE_URL=postgres://grc:CHANGEME@db.host:5432/grc?sslmode=require

# HTTP listen address used by run-app.sh for both profiles.
LISTEN_ADDR=:8080
