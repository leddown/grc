[Unit]
Description=GRC RCSA web application
# network-online (not just network.target) so an external PostgreSQL
# (DATABASE_URL) is reachable at first start; on-failure restarts cover any
# residual races.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=grc
Group=grc
EnvironmentFile=/etc/grc/grc.env
ExecStart=/usr/local/bin/grc
Restart=on-failure
RestartSec=5
# The SQLite database (default backend) lives under
# /var/lib/grc; StateDirectory creates it (mode 0700, owned by
# the service user) and keeps it writable even with ProtectSystem=strict. It is
# harmless and unused when DATABASE_URL points at an external PostgreSQL.
StateDirectory=grc
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Allow binding low ports (e.g. :80) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
