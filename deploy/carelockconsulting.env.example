# Example environment file for the carelockconsulting systemd service.
# scripts/setup.sh generates the real file at
# /etc/carelockconsulting/carelockconsulting.env (mode 0600) with random
# tokens. Copy this only if you are configuring the service by hand.

# Database backend. By default the app uses the embedded SQLite file below.
# To use an external PostgreSQL database instead, set DATABASE_URL (which takes
# precedence over SQLITE_PATH) to a standard connection string. The schema is
# created automatically on startup for either backend.
#   DATABASE_URL=postgres://carelockconsulting:PASSWORD@db.host:5432/carelockconsulting?sslmode=require
DATABASE_URL=

# Path to the SQLite database file (used only when DATABASE_URL is empty). The
# schema is created/upgraded automatically on startup; the parent directory
# must be writable by the service user (the systemd unit provides
# /var/lib/carelockconsulting).
SQLITE_PATH=/var/lib/carelockconsulting/users.db

# HTTP listen address. When running behind nginx (recommended), use a loopback
# address so the port is not exposed directly: 127.0.0.1:8081. For a direct
# public bind without a reverse proxy, use 0.0.0.0:80 (the unit grants
# CAP_NET_BIND_SERVICE for low ports).
LISTEN_ADDR=127.0.0.1:8081

# Enable the JSON writeback endpoints (/controls/save, /security-nfrs/save,
# /jira/json/export). Off by default.
ALLOW_JSON_SAVE=false

# Break-glass admin bearer token for protected mutation endpoints. Generated
# by setup.sh; leave empty to disable token-based admin access.
ADMIN_TOKEN=

# One-time setup token gating POST /auth/bootstrap-admin. Only needed to
# create the first admin; you may blank it out and restart once an admin
# exists.
SETUP_TOKEN=

# Directory holding CHANGELOG.md and the other markdown files served by
# /changelog and /knowledge/*. Leave empty to search the working directory, the
# binary's own directory, and <bindir>/../share/carelockconsulting — which is
# where setup.sh and update.sh install them. Set it explicitly only if the docs
# live somewhere else; a wrong path is reported on the page rather than silently
# falling back. The service's working directory is "/", so without either an
# installed copy or this variable the change log renders empty.
DOCS_DIR=

# Set to true when the app runs behind a reverse proxy (e.g. nginx) that sets
# X-Forwarded-Proto. Required for auth cookies to be marked Secure over HTTPS.
TRUST_PROXY=true

# Reporting module (HTML-to-PDF via headless Chrome). Leave empty to let the
# app find google-chrome/chromium on PATH. Set the path explicitly if Chrome is
# installed somewhere non-standard; PDF report rendering fails without it.
# scripts/verify-install.sh warns when no Chrome can be found.
REPORTING_CHROME_PATH=
# Set to true only where the sandbox cannot be used (some containers). Prefer
# leaving this false and fixing the sandbox.
REPORTING_CHROME_NO_SANDBOX=false

# Optional Wintermute settings for the AI chat assistant. Wintermute is a
# self-hosted server (github.com/l3d/wintermute) that routes a question to a
# model on your own network or on to Claude. Leave empty to configure the
# server URL and token from the UI instead; the Anthropic Claude API provider
# takes its key from the UI only, so no vendor key is ever stored here.
WINTERMUTE_URL=
WINTERMUTE_TOKEN=
WINTERMUTE_BACKEND=
WINTERMUTE_MODEL=
