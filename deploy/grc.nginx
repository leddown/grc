server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name grc.l3d.local;

    ssl_certificate     /etc/nginx/ssl/l3d-local.crt;
    ssl_certificate_key /etc/nginx/ssl/l3d-local.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Policy Studio collaboration socket. WebSocket needs the upgrade headers
    # passed through, and a long read timeout: an editor that is only reading
    # sends a ping every 30 s, so 300 s would cut an idle reader off. The app
    # authorizes every upgrade itself (session cookie and Origin), so this
    # block adds no access control of its own.
    location /collab/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        proxy_connect_timeout 10s;
    }
}
