# Example environment file for the grc-render systemd service, on the host
# that typesets for a GRC installation elsewhere (a Wintermute rig node such
# as coven). scripts/install-grc-render.sh writes the real file at
# /etc/grc/grc-render.env (mode 0640, group grc-render) with a random token.

# Where to listen. Reachable from the GRC host, and nowhere else: pair it with
# a firewall rule such as
#   sudo ufw allow from 10.232.231.9 to any port 8892 proto tcp
GRC_RENDER_ADDR=0.0.0.0:8892

# The bearer token GRC presents, as RENDER_TOKEN in its own env file. At least
# 32 characters: openssl rand -hex 32
GRC_RENDER_TOKEN=

# HTTPS, with a certificate from the fleet's internal CA (Wintermute's
# scripts/internal-ca.sh issue <host> <ip>). Set both, readable by grc-render;
# GRC then uses an https:// RENDER_URL and trusts the CA with RENDER_CA_FILE.
GRC_RENDER_TLS_CERT=
GRC_RENDER_TLS_KEY=

# How many documents to typeset at once.
GRC_RENDER_CONCURRENCY=2

# Paths of the typesetters, when not on the service's PATH.
#TYPST=/usr/local/bin/typst
#PANDOC=/usr/local/bin/pandoc
