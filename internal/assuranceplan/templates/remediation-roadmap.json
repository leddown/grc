{
  "key": "remediation-roadmap",
  "order": 5,
  "name": "Remediation roadmap",
  "description": "Open audit, regulatory and certification findings planned to closure: each finding in the wave of the quarter it is due, quarterly milestones, 2LoD validation of every closure, and reporting on the committee cadence. The population is proposed from Audit Findings.",
  "plan": {
    "title": "{year} Remediation Roadmap",
    "function_name": "2LoD ICT Risk (remediation oversight)",
    "objective": "By {period_end_long}, every open finding due in {year} is remediated and its closure independently validated, or formally risk-accepted, with progress reported to the ICT Risk Committee each quarter and to the Audit Committee on its cadence.",
    "decisions_requested": "Approve the {year} remediation roadmap: the open findings, the quarter each is due to close, and the owners.\nEndorse the validation approach: 2LoD validates every closure before a finding is closed.\nAgree the escalation of overdue findings and of repeated extensions.",
    "regulatory_refs": "DORA Art. 6(5), 6(7); IIA Global Internal Audit Standards 15.2",
    "owner_role": "Remediation PMO (2LoD)",
    "accountable_role": "Head of ICT Risk (2LoD)",
    "approval_forum": "ICT Risk Committee",
    "mobilise_start": "period_start-30d",
