  "regulatory_basis": [
    {
      "requirement": "Based on the conclusions of the internal audit review, establish a formal follow-up process, including rules for the timely verification and remediation of critical ICT audit findings.",
      "reference": "DORA Art. 6(7)",
      "how": "Every open finding is on the roadmap in the quarter it is due, and its closure is validated before it is closed."
    },
    {
      "requirement": "Confirm that management has implemented the recommendations or action plans, or accepted the risk of not doing so.",
      "reference": "IIA Global Internal Audit Standards 15.2",
      "how": "Attributes VR-01 to VR-04; a risk acceptance is recorded in Audit Findings with its approver and expiry."
    },
    {
      "requirement": "Review the ICT risk management framework at least once a year, including the remediation of findings.",
      "reference": "DORA Art. 6(5)",
      "how": "The year-end report gives the closures validated, the acceptances and the carry-over into next year."
    }
  ]
