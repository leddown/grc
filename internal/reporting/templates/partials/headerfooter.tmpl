{{define "pdf_header"}}<div style="width:100%; font-size:7pt; color:#5a6473; font-family:Helvetica, Arial, sans-serif; padding:0 14mm; -webkit-print-color-adjust:exact; display:flex; justify-content:space-between; align-items:center;">
  <span>{{.Branding.OrgName}}</span>
  {{if not .Classification.IsZero}}<span style="font-weight:700; letter-spacing:0.1em; color:{{.Classification.BannerColor}};">{{.Classification}}</span>{{end}}
  <span>{{.Cover.Title}}</span>
</div>{{end}}

{{define "pdf_footer"}}<div style="width:100%; font-size:7pt; color:#5a6473; font-family:Helvetica, Arial, sans-serif; padding:0 14mm; display:flex; justify-content:space-between; align-items:center;">
  <span>Generated {{formatDate .Cover.GeneratedAt}}{{if .Cover.Version}} &middot; v{{.Cover.Version}}{{end}}</span>
  <span>Page <span class="pageNumber"></span> of <span class="totalPages"></span></span>
  {{if not .Classification.IsZero}}<span style="font-weight:700; color:{{.Classification.BannerColor}};">{{.Classification}}</span>{{else}}<span></span>{{end}}
</div>{{end}}
